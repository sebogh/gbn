\GBN@def{anlagen}{GBN@anlagen}{}

% Bausteine
\newcommand*\GBN@senderName{%
  \ifx\GBN@fromTitel\empty\else\GBN@fromTitel~\fi\GBN@fromName}
\newcommand*\GBN@label[1]{\textcolor{GBN@muted}{#1}}
\newcommand*\GBN@tabularNums{\addfontfeatures{Numbers={Lining,Monospaced}}}
\newcommand*\GBN@rule[1]{\textcolor{GBN@muted!40}{\rule{#1}{0.4pt}}}

% Name im Kopf: gesperrte Versalien in der Akzentfarbe
\newcommand*\GBN@headName{{%
  \color{GBN@accent}\fontsize{15}{18}\selectfont
  \addfontfeatures{LetterSpace=8}%
  \MakeUppercase{%
    \ifx\GBN@headerName\empty\GBN@fromName\else\GBN@headerName\fi}}}

% Informationsblock (DIN 5008): Bezugszeichen, Datum, ggf. Seitenzahl.
% Feste Breite bis zum rechten Textrand; lange Werte werden umbrochen.
\newcommand*\GBN@infoRow[2]{\ifx#2\empty\else\GBN@label{#1}&#2\\\fi}
\newcommand*\GBN@infoBlock{{%
  \small\GBN@tabularNums
  \setlength\tabcolsep{0pt}%
  \renewcommand\arraystretch{1.1}%
  \begin{tabularx}{\GBN@infoWidth}[t]{l@{\hspace{4mm}}>{\RaggedRight\arraybackslash}X}%
    \GBN@infoRow{\GBN@ihrZeichenText}{\GBN@ihrZeichen}%
    \GBN@infoRow{\GBN@ihreNachrichtText}{\GBN@ihreNachricht}%
    \GBN@infoRow{\GBN@unserZeichenText}{\GBN@unserZeichen}%
    \GBN@label{\GBN@datumText}&\GBN@datum\\%
    \ifnum\GBN@total>1
      \GBN@label{\GBN@seiteText}&\thepage\ \GBN@vonText\ \GBN@total\\%
    \fi
  \end{tabularx}}}

% Fußzeile: drei gleich breite Spalten mit Überschrift; leere Spalten
% bleiben leer.
\newcommand*\GBN@line[1]{\ifx#1\empty\else#1\par\fi}
\newcommand*\GBN@footPair[2]{\ifx#2\empty\else\GBN@label{#1}\enspace#2\par\fi}
\newcommand\GBN@footCol[2]{%
  \sbox\GBN@box{\parbox[t]{\GBN@footColWidth}{#2}}%
  \parbox[t]{\GBN@footColWidth}{\RaggedRight
    \ifdim\dimexpr\ht\GBN@box+\dp\GBN@box\relax>\z@
      {\GBN@label{\scriptsize\addfontfeatures{LetterSpace=6}\MakeUppercase{#1}}}%
      \par\vspace{0.8mm}#2%
    \fi}}
\newcommand*\GBN@footer{{%
  \footnotesize\GBN@tabularNums
  \GBN@footCol{\GBN@anschriftText}{%
    \GBN@line{\GBN@fromName}%
    \GBN@line{\GBN@fromStrasseHaus}%
    \GBN@line{\GBN@fromPlzOrt}%
    \GBN@line{\GBN@fromLand}}%
  \GBN@footCol{\GBN@kontaktText}{%
    \GBN@footPair{\GBN@telefonText}{\GBN@fromTelefon}%
    \GBN@footPair{\GBN@telefaxText}{\GBN@fromTelefax}%
    \GBN@line{\GBN@fromEMail}%
    \GBN@line{\GBN@fromHTTP}}%
  \GBN@footCol{\GBN@bankText}{%
    \GBN@line{\GBN@fromBank}%
    \GBN@footPair{\GBN@ibanText}{\GBN@fromIBAN}%
    \GBN@footPair{\GBN@bicText}{\GBN@fromBIC}}}}

% Alle festen Elemente der ersten Seite
\newcommand*\GBN@firstPage{%
  \setlength\unitlength{1mm}%
  %
  % Kopfzeile
  \put(\LenToUnit\GBN@fHeadX, \LenToUnit\GBN@fHeadNameY){\GBN@headName}%
  \ifGBN@rules
    \put(\LenToUnit\GBN@fHeadLineX, \LenToUnit\GBN@fHeadLineY){%
      \GBN@rule{\GBN@fHeadLineWidth}}%
  \fi
  %
  % Rücksendeangabe; wird auf die Breite des Anschriftfelds (bis 105 mm)
  % verkleinert, falls nötig
  \sbox\GBN@box{\scriptsize\color{GBN@muted}%
      \GBN@senderName\ \textperiodcentered\ %
      \GBN@fromStrasseHaus\ \textperiodcentered\ %
      \GBN@fromPlzOrt}%
  \ifdim\wd\GBN@box>80mm
    \sbox\GBN@box{\resizebox{80mm}{!}{\usebox\GBN@box}}%
  \fi
  \put(25, \LenToUnit\GBN@retourY){\usebox\GBN@box}%
  %
  % Zusatz- und Vermerkzone
  \put(25, \LenToUnit\GBN@extrasY){%
    \parbox[t][12.7mm]{78mm}{%
      \vfill
      \parbox{78mm}{\scriptsize
        \ifx\GBN@zvzThree\empty ~\else\GBN@zvzThree\fi\\%
        \ifx\GBN@zvzTwo\empty ~\else\GBN@zvzTwo\fi\\%
        \GBN@zvzOne}%
      \vfill}}%
  %
  % Anschrift
  % Von oben gefüllt (DIN 5008), leere Zeilen entfallen. [t]: der
  % Bezugspunkt ist die Grundlinie der ersten Zeile. Zeilenabstand 12.6pt
  % (4.45 mm), damit sechs Zeilen in die Anschriftzone (bis 72 mm) passen.
  \put(25, \LenToUnit\GBN@addressBaseY){%
    \parbox[t]{78mm}{\linespread{1}\fontsize{11}{12.6pt}\selectfont
      \GBN@line{\GBN@toFirma}%
      \GBN@line{\GBN@toAnrede}%
      \ifx\GBN@toName\empty\else
        \ifx\GBN@toTitel\empty\else\GBN@toTitel~\fi\GBN@toName\par
      \fi
      \GBN@line{\GBN@toStrasseHaus}%
      \GBN@line{\GBN@toPlzOrt}%
      \GBN@line{\GBN@toLand}}}%
  %
  % Informationsblock: erste Zeile auf der Grundlinie der Rücksendeangabe
  \put(\LenToUnit\GBN@infoX, \LenToUnit\GBN@retourY){\GBN@infoBlock}%
  %
  % Falz- und Lochmarken
  {\color{GBN@muted}\linethickness{0.3pt}%
    \put(0, \LenToUnit\GBN@faltmarkeTop){\line(1,0){3}}%
    \put(0, \LenToUnit\GBN@lochmarke){\line(1,0){5}}%
    \put(0, \LenToUnit\GBN@faltmarkeBottom){\line(1,0){3}}}%
  %
  % Fußzeile
  \put(\LenToUnit\GBN@fFootX, \LenToUnit\GBN@fFootY){\GBN@footer}%
  \ifGBN@rules
    \put(\LenToUnit\GBN@fFootLineX, \LenToUnit\GBN@fFootLineY){%
      \GBN@rule{\GBN@fFootLineWidth}}%
  \fi
  \ifGBN@rulers\rulers{20}{-297}\fi}

% Feste Elemente der regulären Seiten
\newcommand*\GBN@regularPage{%
  \setlength\unitlength{1mm}%
  \ifnum\GBN@total>1
    \put(\LenToUnit{(\GBN@rFootX + \GBN@rFootWidth)}, \LenToUnit\GBN@rFootY){%
      \makebox(0,0)[r]{\footnotesize\GBN@tabularNums\GBN@label{%
          \GBN@seiteText\ \thepage\ \GBN@vonText\ \GBN@total}}}%
  \fi
  \ifGBN@rules
    \put(\LenToUnit\GBN@rFootLineX, \LenToUnit\GBN@rFootLineY){%
      \GBN@rule{\GBN@rFootLineWidth}}%
  \fi}

% erste Seite
\def\ps@first{%
  \setlength{\headsep}{-\GBN@windowBottom - 1.2in + \GBN@fHeadSep}%
  \def\@oddhead{\AddToShipoutPicture*{\GBN@firstPage}}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{}%
  \let\@evenfoot\@oddfoot}

% reguläre Seite
\def\ps@regularpage{%
  \setlength{\headsep}{\GBN@rHeadHeight - 1.2in + \GBN@rHeadSep}%
  \def\@oddhead{}%
  \let\@evenhead\@oddhead
  \def\@oddfoot{\AddToShipoutPicture*{\GBN@regularPage}}%
  \let\@evenfoot\@oddfoot}

% Seiten ohne Kopf oder Fuß
\def\ps@empty{%
  \setlength{\headsep}{\GBN@rHeadHeight - 1.2in + \GBN@rHeadSep}%
  \def\@oddhead{}%
  \def\@evenhead{}%
  \def\@oddfoot{}%
  \def\@evenfoot{}}


\ifGBN@plain
  \setlength\textheight{%
    \GBN@paperHeight %
    - \GBN@rHeadHeight %
    - \GBN@rHeadSep %
    - \GBN@rFootHeight %
    - \GBN@rFootSep}
\else
  \setlength\textheight{%
    \GBN@paperHeight %
    + \GBN@windowBottom %
    - \GBN@fHeadSep %
    - \GBN@fFootHeight %
    - \GBN@fFootSep}
\fi

% Dinge, die direkt bei \begin{document} zu tun sind
\AtBeginDocument{%
  \ifGBN@plain
    \thispagestyle{regularpage}%
  \else
    \thispagestyle{first}%
    \setlength\textheight{%
      \GBN@paperHeight %
      - \GBN@rHeadHeight %
      - \GBN@rHeadSep %
      - \GBN@rFootHeight %
      - \GBN@rFootSep}%
    \ifdim\GBN@subjectsep>\z@\vspace*{\GBN@subjectsep}\fi
    \ifx\GBN@betreff\empty\else
      \textbf{\GBN@betreff}\vspace*{\GBN@salutsep}\par
    \fi
    \ifx\GBN@begruessung\empty\else
      \GBN@begruessung\vspace*{\GBN@bodysep}\par
    \fi
  \fi}

% Dinge, die direkt bei \end{document} zu tun sind
\AtEndDocument{
  \hypersetup{
    pdftitle={\GBN@betreff},
    pdfauthor={\GBN@senderName},
  }
  \par
  \ifGBN@plain%
    \vfill%
  \else%
    \parbox[t]{3.5in}{\raggedright\ignorespaces{
        \normalsize%
        \ifx\GBN@gruss\empty\else\GBN@gruss\mbox{}\\[16.92mm]\fi%
        \ifx\GBN@signatur\empty%
           \ifx\GBN@unterschrift\empty\relax\else\GBN@unterschrift\fi%
        \else%
          \vspace*{-1cm}\parbox[t][2cm]{10cm}{%
            \includegraphics[width=4.5cm]{\GBN@signatur}%
          }%
        \fi%
      }\strut}%
    \vspace*{-1.5cm}\\ % Überlappung Anlagen und Unterschrift
    \parbox{\textwidth}{\hfill\GBN@anlagen\medskip}\\%
  \fi%
}

\def\rulers#1#2{
  \newcounter{x}
  \setcounter{x}{#1}
  \newcounter{y}
  \setcounter{y}{#2}
  \put(\value{x},\value{y}){\vrule height 2mm width .4pt}
  \put(\value{x},\value{y}){\rule{2mm}{.4pt}}
  \addtocounter{x}{-300}
  \multiput(\value{x},\value{y})(1, 0){600}{\vrule height 1mm width .1pt}
  \multiput(\value{x},\value{y})(10, 0){60}{\vrule height 2mm width .15pt}
  \addtocounter{y}{4}
  \put(\value{x}, \value{y}){\makebox(0,0){\scriptsize -300}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 250}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 200}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 150}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 100}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 50}}
  \addtocounter{x}{100}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 50}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 100}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 150}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 200}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 250}}
  \addtocounter{x}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 300}}
  \addtocounter{x}{-300}
  \addtocounter{y}{-304}
  \multiput(\value{x},\value{y})(0, 1){600}{\rule{1mm}{.1pt}}
  \multiput(\value{x},\value{y})(0, 10){60}{\rule{2mm}{.15pt}}
  \addtocounter{x}{4}
  \put(\value{x}, \value{y}){\makebox(0,0){\scriptsize -300}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 250}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 200}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 150}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 100}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 50}}
  \addtocounter{y}{100}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 50}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 100}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 150}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 200}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 250}}
  \addtocounter{y}{50}\put(\value{x}, \value{y}){\makebox(0,0){\scriptsize 300}}
}

