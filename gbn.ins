        \file{gbn.cls}{\from{gbn.dtx}{class}}
        \file{test-simple.tex}{\from{gbn.dtx}{testsimple}}
        \file{test-complete.tex}{\from{gbn.dtx}{testcomplete}}
}


\Msg{*********************************************************}
\Msg{*}
\Msg{* To finish the installation you have to move the}
\Msg{* following file into a directory searched by TeX:}
\Msg{*}
\Msg{* \space\space gbn.cls}
\Msg{*}
\Msg{* To produce the documentation run the file gbn.dtx}
\Msg{* through LaTeX.}
\Msg{*}
\Msg{* To produce example output run the file test-simple.tex}
\Msg{* and/or test-complete.tex through through LaTeX.}
\Msg{*}
\Msg{* Happy TeXing!}
\Msg{*********************************************************}

\endbatchfile
